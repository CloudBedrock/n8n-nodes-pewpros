{
  "name": "n8n-nodes-pewpros",
  "version": "0.2.1",
  "description": "n8n community node for the Pewpros CRM, events, and learning platform",
  "keywords": [
    "n8n-community-node-package"
  ],
  "license": "MIT",
  "author": {
    "name": "CloudBedrock",
    "email": "support@cloudbedrock.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CloudBedrock/n8n-nodes-pewpros.git"
  },
  "homepage": "https://pewpros.com",
  "bugs": {
    "url": "https://github.com/CloudBedrock/n8n-nodes-pewpros/issues"
  },
  "engines": {
    "node": ">=20.15"
  },
  "scripts": {
    "build": "npx rimraf dist && tsc && gulp build:icons && cp package.json dist/",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes/**/*.ts credentials/**/*.ts --ext .ts",
    "lintfix": "eslint nodes/**/*.ts credentials/**/*.ts --ext .ts --fix",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/PewprosApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Pewpros/Pewpros.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.0.12",
    "@typescript-eslint/parser": "~8.32.0",
    "eslint": "^8.57.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.3",
    "gulp": "^5.0.0",
    "n8n-workflow": "^1.82.0",
    "prettier": "^3.5.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3"
  }
}
